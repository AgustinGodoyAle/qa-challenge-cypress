{
  "name": "qa-challenge-cypress",
  "version": "1.0.0",
  "description": "Challenge QA: API testing (Fake Store API) y E2E UI (Sauce Demo) con Cypress",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.js\"",
    "test:ui:headed": "cypress run --headed --browser chrome --spec \"cypress/e2e/ui/**/*.cy.js\""
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.17.1",
    "cypress": "^15.21.1"
  }
}
